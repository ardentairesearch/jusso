# Jusso Arc testnet configuration. Never commit real credentials.

# -- Arc network -----------------------------------------------------------
ARC_NETWORK=arc-testnet
ARC_RPC_URL=https://rpc.testnet.arc.io

# -- Alchemy Wallet API and gas sponsorship -------------------------------
ALCHEMY_API_KEY=
ALCHEMY_GAS_POLICY_ID=
ARC_MAX_SPONSORED_GAS_UNITS=2000000
ARC_MAX_SPONSORED_GAS_COST_WEI=100000000000000000

# -- Execution fee ---------------------------------------------------------
EXECUTION_FEE_RECIPIENT=
GAS_MARKUP_BPS=1000
PLATFORM_FEE_USDC_RAW=10000
ARC_RECEIPT_TIMEOUT_SECONDS=180

# -- Turnkey parent organization ------------------------------------------
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_CREDENTIAL_ENCRYPTION_KEY=

# -- Authentication and secret encryption --------------------------------
AUTH_SECRET_ENCRYPTION_KEY=
OAUTH_SIGNING_SECRET=
BOOTSTRAP_ADMIN_TOKEN=
OAUTH_ISSUER=http://localhost:8080
OAUTH_AUDIENCE=http://localhost:8080
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900

# -- Public API ------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_REGISTRATION_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# -- Browser onboarding ----------------------------------------------------
WEBAUTHN_ORIGIN=http://localhost:8080
WEBAUTHN_RP_ID=localhost
REGISTRATION_TURNSTILE_SITE_KEY=
REGISTRATION_TURNSTILE_SECRET=
REGISTRATION_ALLOWED_HOSTNAMES=
REGISTRATION_CLIENT_IP_HEADER=
REGISTRATION_HOURLY_LIMIT=5

# -- PostgreSQL and Redis --------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jusso
REDIS_URL=redis://127.0.0.1:6379

# -- Workers and limits ----------------------------------------------------
NUM_WORKERS=2
MAX_CONCURRENT_REQUESTS=200
PER_PRINCIPAL_RATE_LIMIT_RPS=5.0
PER_PRINCIPAL_RATE_LIMIT_BURST=10.0
RUST_LOG=info

# Optional and disabled for the Arc testnet deployment:
# TURNKEY_BASE_URL=
# Onramper is Arc-mainnet-only and requires all four values together:
# ONRAMPER_API_KEY=
# ONRAMPER_SIGNING_PRIVATE_KEY_PKCS8_BASE64=
# ONRAMPER_USDC_ASSET_ID=
# ONRAMPER_ARC_NETWORK_ID=
# ONRAMPER_WIDGET_URL=https://buy.onramper.com
